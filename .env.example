# K-Life Protocol v2.1 — Environment Variables

# Agent wallet (WDK — seed phrase, never a raw private key)
KLIFE_WALLET_SEED=your twelve word seed phrase here

# Lock period: 3, 30, or 90 days
KLIFE_LOCK_DAYS=90

# K-Life API
KLIFE_API_URL=https://klife.monsieurk.io

# RPC (Polygon mainnet)
KLIFE_RPC=https://polygon-bor-rpc.publicnode.com

# Oracle (for server only — not needed by agents)
KLIFE_ORACLE_KEY=your-oracle-key
